+// Temporary benchmark instrumentation, never part of the production library.
+enum JXLProbe {
+    // Changed only between synchronous operations/batches by the probe.
+    nonisolated(unsafe) static var resizable = false
+    nonisolated(unsafe) static var threads = -1
+    private static let lock = NSLock()
+    nonisolated(unsafe) private static var bytes = 0
+    static func recordAllocation(_ count: Int) { lock.lock(); bytes += count; lock.unlock() }
+    static func resetAllocations() { lock.lock(); bytes = 0; lock.unlock() }
+    static var allocatedBytes: Int { lock.lock(); defer { lock.unlock() }; return bytes }
+}
